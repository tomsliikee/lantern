msgstr "Die Seiten der GNOME-Einstellungen."

#: extension/prefs.js:30
msgid "System actions"
msgstr "Systemaktionen"

#: extension/prefs.js:30
msgid ""
"Lock, log out, suspend, restart, power off. The last three ask in GNOME’s "
"own dialog."
msgstr ""
"Sperren, Abmelden, Bereitschaft, Neustart, Ausschalten. Die letzten drei "
"fragen in GNOMEs eigenem Dialog."

#: extension/prefs.js:31
msgid "Calculator and units"
msgstr "Rechner und Einheiten"

#: extension/prefs.js:31
msgid "Sums and conversions, worked out on this computer."
msgstr "Rechnungen und Umrechnungen, auf diesem Rechner ausgerechnet."

#: extension/prefs.js:32
msgid "Files by name"
msgstr "Dateien nach Name"

#: extension/prefs.js:32
msgid "From LocalSearch, after two letters and a short pause."
msgstr "Aus LocalSearch, ab zwei Buchstaben und einer kurzen Pause."

