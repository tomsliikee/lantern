msgstr "Tastenkürzel"

#: extension/prefs.js:118
msgid "Press the keys"
msgstr "Tasten drücken"

#: extension/prefs.js:118
msgid "Escape leaves it as it is."
msgstr "Escape lässt es, wie es ist."

