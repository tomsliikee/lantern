#: extension/prefs.js:183
#, javascript-format
msgid "Taken by GNOME as well (%s). Choose another, or free it there."
msgstr "Auch von GNOME belegt (%s). Ein anderes wählen oder es dort freigeben."

#: extension/prefs.js:184
msgid "Opens and closes the launcher."
msgstr "Öffnet und schließt den Launcher."

#: extension/prefs.js:188
msgid "Taken from the input source switch; Shift+Super+Space still switches."
msgstr ""
"Vom Wechsel der Eingabequelle übernommen; Umschalt+Super+Leertaste wechselt "
"weiterhin."

#: extension/prefs.js:189
msgid "Give back"
msgstr "Zurückgeben"

#: extension/prefs.js:192
msgid ""
"Switches input sources now. Take it for the launcher; Shift+Super+Space "
"keeps switching."
msgstr ""
"Wechselt jetzt die Eingabequelle. Für den Launcher übernehmen; "
"Umschalt+Super+Leertaste wechselt weiterhin."

