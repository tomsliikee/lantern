#: extension/prefs.js:207
msgid "Preview column"
msgstr "Vorschau-Spalte"

#: extension/prefs.js:208
msgid "Beside the results, for the selected one."
msgstr "Neben den Ergebnissen, für das ausgewählte."

#: extension/prefs.js:209
msgid "On wide screens"
msgstr "Auf breiten Bildschirmen"

#: extension/prefs.js:209
msgid "Always"
msgstr "Immer"

#: extension/prefs.js:209
msgid "Never"
msgstr "Nie"

#: extension/prefs.js:214
msgid "See-through"
msgstr "Durchsichtig"

