#: extension/extension.js:147
msgid "Material Search opens with Ctrl+Space"
msgstr "Material Search öffnet mit Strg+Leertaste"

#: extension/extension.js:148
msgid ""
"Super+Space switches input sources. Take it for the launcher? "
"Shift+Super+Space keeps switching input sources."
msgstr ""
"Super+Leertaste wechselt die Eingabequelle. Für den Launcher übernehmen? "
"Umschalt+Super+Leertaste wechselt weiterhin die Eingabequelle."

#: extension/extension.js:151
msgid "Use Super+Space"
msgstr "Super+Leertaste nehmen"

#: extension/extension.js:155
msgid "Keep Ctrl+Space"
msgstr "Strg+Leertaste behalten"

#: extension/prefs.js:27 extension/sources/apps.js:45
msgid "Apps"
msgstr "Apps"

#: extension/prefs.js:27
msgid "Installed apps, by name, kind and keywords."
msgstr "Installierte Apps, nach Name, Art und Stichwörtern."

#: extension/prefs.js:28 extension/sources/windows.js:21
msgid "Windows"
msgstr "Fenster"

#: extension/prefs.js:28
